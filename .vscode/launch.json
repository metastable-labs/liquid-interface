  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Expo App",
      "program": "${workspaceFolder}/app/index.tsx",
      "preLaunchTask": "yarn: start"
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "programPath",
      "description": "Path to the main program file"
    }
  ]
}
